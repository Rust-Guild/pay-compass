---
import Layout from '../layouts/Layout.astro';
import { parseAllDataForHome, parseTransferDataForHome, getRegionFlag } from '../utils/data';

const base = import.meta.env.BASE_URL || '';
const { categories, providers } = parseAllDataForHome();
const { countries: transferCountries } = parseTransferDataForHome();

// Динамический расчёт статистики
const totalServices = categories.reduce((sum, cat) => sum + cat.services.length, 0);
const totalProviders = Object.keys(providers).length;
const totalRegions = categories.reduce((sum, cat) => {
  return sum + cat.services.reduce((s, svc) => s + svc.regions.length, 0);
}, 0) + transferCountries.length;

function pluralizeRegions(n: number): string {
  const abs = Math.abs(n) % 100;
  const n1 = abs % 10;
  if (abs > 10 && abs < 20) return 'регионов';
  if (n1 === 1) return 'регион';
  if (n1 >= 2 && n1 <= 4) return 'региона';
  return 'регионов';
}
---
<Layout 
  title="PayCompass — Сравни курсы, плати меньше"
  description="Сравниваем курсы пополнения, ваучеров и международных переводов. Steam, PlayStation, App Store, переводы в Армению, Казахстан, Грузию и другие страны. Найди лучшую цену за секунду."
>
  <style>
    /* ===== HERO ===== */
    .hero {
      text-align: center;
      padding: 4rem 0 3.5rem;
      position: relative;
    }

    .hero-eyebrow {
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--color-amber);
      margin-bottom: 0.75rem;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
    }

    .hero-eyebrow::before,
    .hero-eyebrow::after {
      content: '';
      width: 24px;
      height: 1px;
      background: var(--color-amber-dim);
      opacity: 0.5;
    }

    .hero h1 {
      font-size: clamp(2.25rem, 6vw, 3.5rem);
      font-weight: 700;
      letter-spacing: -0.05em;
      line-height: 1.05;
      margin-bottom: 0.75rem;
    }

    .hero h1 .accent {
      color: var(--color-amber);
    }

    .hero-subtitle {
      font-size: 1.0625rem;
      color: var(--color-text-muted);
      max-width: 480px;
      margin: 0 auto;
      line-height: 1.6;
    }

    /* ===== HERO VISUAL ===== */
    .hero-visual {
      position: absolute;
      top: 50%;
      right: 8%;
      transform: translateY(-50%);
      width: 240px;
      height: 240px;
      opacity: 0.5;
      pointer-events: none;
    }

    .hero-visual--left {
      right: auto;
      left: 8%;
    }

    /* --- Кольца --- */
    .compass-ring {
      fill: none;
      stroke: var(--color-amber);
      stroke-width: 1.2;
      opacity: 0.9;
    }

    .compass-ring--inner {
      stroke: var(--color-teal);
      opacity: 0.6;
      stroke-width: 1;
    }

    .compass-ring--outer {
      stroke-width: 0.8;
      opacity: 0.6;
      stroke-dasharray: 3 5;
      /* Вращение через SVG <animateTransform>, не через CSS */
    }

    .compass-ring--dashed {
      stroke: var(--color-teal);
      stroke-width: 0.8;
      opacity: 0.5;
      stroke-dasharray: 4 8;
      /* Вращение через SVG <animateTransform>, не через CSS */
    }

    .compass-ring--thin {
      stroke-width: 0.5;
      opacity: 0.4;
    }

    /* --- Стрелка --- */
    .compass-needle {
      /* Вращение через SVG <animateTransform>, не через CSS transform */
    }

    .compass-needle--north {
      fill: var(--color-amber);
    }

    .compass-needle--south {
      fill: var(--color-teal);
      opacity: 0.8;
    }

    /* --- Центр --- */
    .compass-dot {
      fill: var(--color-amber);
      /* Пульсация через SVG <animate>, не через CSS */
    }

    .compass-dot--outer {
      fill: none;
      stroke: var(--color-amber);
      stroke-width: 1;
      opacity: 0.6;
      /* Пульсация через SVG <animate>, не через CSS */
    }

    /* --- Метки --- */
    .compass-tick {
      stroke: var(--color-amber);
      stroke-width: 1.2;
      opacity: 0.6;
    }

    .compass-tick--minor {
      stroke-width: 0.8;
      opacity: 0.4;
    }

    .compass-tick--micro {
      stroke-width: 0.5;
      opacity: 0.25;
    }

    /* --- Подписи --- */
    .compass-label {
      fill: var(--color-amber);
      font-family: var(--font-mono);
      font-size: 8px;
      opacity: 0.85;
      text-anchor: middle;
      dominant-baseline: central;
    }

    /* --- Дуги --- */
    .compass-arc {
      fill: none;
      stroke: var(--color-amber);
      stroke-width: 0.6;
      opacity: 0.4;
    }

    .compass-arc--teal {
      stroke: var(--color-teal);
      opacity: 0.35;
    }

    /* --- Ромб-декор --- */
    .compass-diamond {
      fill: none;
      stroke: var(--color-amber);
      stroke-width: 0.6;
      opacity: 0.35;
    }

    /* --- Keyframes --- */
    @media (max-width: 640px) {
      .hero-visual {
        display: none;
      }
    }

    /* ===== SEARCH ===== */
    .search-section {
      margin-bottom: 3.5rem;
    }

    /* ===== SECTIONS ===== */
    .section {
      margin-bottom: 3.5rem;
    }

    .category-block {
      margin-bottom: 2.5rem;
    }

    .category-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.875rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid var(--color-border);
    }

    .category-title {
      font-family: var(--font-display);
      font-size: 1.125rem;
      font-weight: 600;
      letter-spacing: -0.02em;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .category-count {
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      color: var(--color-text-faint);
      font-weight: 400;
    }

    .category-link {
      color: var(--color-text-muted);
      font-size: 0.75rem;
      font-weight: 500;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      padding: 0.25rem 0.5rem;
      border-radius: var(--radius-sm);
      transition: all var(--transition-fast);
    }

    .category-link:hover {
      color: var(--color-amber);
      background: var(--color-amber-glow);
    }

    /* ===== SERVICE GRID ===== */
    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 0.75rem;
    }

    .service-card {
      text-decoration: none;
      color: inherit;
      display: block;
    }

    .service-card .card {
      height: 100%;
    }

    .service-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.5rem;
    }

    .service-name {
      font-family: var(--font-display);
      font-size: 1rem;
      font-weight: 600;
      letter-spacing: -0.02em;
    }

    .service-regions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem;
    }

    .service-region {
      font-size: 0.6875rem;
      color: var(--color-text-muted);
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      background: var(--color-night-subtle);
      padding: 0.125rem 0.5rem;
      border-radius: 100px;
    }

    .service-region--more {
      color: var(--color-text-faint);
      font-family: var(--font-mono);
    }

    .savings-badge {
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      color: var(--color-success);
      font-weight: 500;
      display: flex;
      align-items: center;
      gap: 0.375rem;
      margin-bottom: 0.5rem;
      padding: 0.1875rem 0.5rem;
      background: var(--color-success-bg);
      border-radius: 100px;
      border: 1px solid rgba(20, 184, 166, 0.15);
      width: fit-content;
    }

    .service-region-flag {
      font-size: 0.8125rem;
    }

    /* ===== EMPTY STATE ===== */
    .empty-state {
      text-align: center;
      padding: 3rem 1rem;
      color: var(--color-text-faint);
      font-size: 0.9375rem;
    }

    /* ===== WHY SECTION ===== */
    .why-section {
      margin-bottom: 2.5rem;
    }

    .why-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }

    .why-card {
      text-align: center;
      padding: 1.5rem 1rem;
    }

    .why-card-icon {
      font-size: 1.75rem;
      margin-bottom: 0.75rem;
      display: block;
    }

    .why-card h3 {
      margin-bottom: 0.375rem;
      font-size: 0.9375rem;
    }

    .why-card p {
      font-size: 0.8125rem;
      color: var(--color-text-muted);
      line-height: 1.5;
    }

    /* ===== STATS BAR ===== */
    .stats-bar {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
      margin-bottom: 2.5rem;
      padding: 1.25rem;
    }

    .stat-item {
      text-align: center;
    }

    .stat-value {
      font-family: var(--font-display);
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--color-amber);
      letter-spacing: -0.03em;
      display: block;
    }

    .stat-label {
      font-size: 0.75rem;
      color: var(--color-text-muted);
      margin-top: 0.125rem;
    }

    /* ===== FAQ SECTION ===== */
    .faq-section {
      margin-bottom: 2.5rem;
    }

    .faq-section h2 {
      text-align: center;
      margin-bottom: 1.5rem;
    }

    .faq-item {
      border-bottom: 1px solid var(--color-border);
    }

    .faq-question {
      width: 100%;
      background: none;
      border: none;
      color: var(--color-text);
      font-family: var(--font-display);
      font-size: 0.9375rem;
      font-weight: 600;
      text-align: left;
      padding: 1rem 0;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
    }

    .faq-question:hover {
      color: var(--color-amber);
    }

    .faq-icon {
      flex-shrink: 0;
      transition: transform var(--transition-base);
      color: var(--color-text-faint);
    }

    .faq-item.open .faq-icon {
      transform: rotate(45deg);
    }

    .faq-answer {
      max-height: 0;
      overflow: hidden;
      transition: max-height var(--transition-slow), padding var(--transition-slow);
    }

    .faq-item.open .faq-answer {
      max-height: 300px;
      padding-bottom: 1rem;
    }

    .faq-answer p {
      font-size: 0.875rem;
      color: var(--color-text-muted);
      line-height: 1.6;
    }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 640px) {
      .hero {
        padding: 2rem 0 1.5rem;
      }
      .services-grid {
        grid-template-columns: 1fr;
      }
      .why-grid {
        grid-template-columns: 1fr;
      }
      .stats-bar {
        grid-template-columns: repeat(2, 1fr);
      }
    }
  </style>

  <div>
    <!-- Hero -->
    <section class="hero">
      <!-- Compass Visual -->
      <svg class="hero-visual" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
        <!-- ===== Кольца ===== -->
        <!-- Внешнее пунктирное кольцо (вращается) -->
        <g>
          <animateTransform attributeName="transform" type="rotate" from="0 100 100" to="360 100 100" dur="80s" repeatCount="indefinite"/>
          <circle class="compass-ring compass-ring--outer" cx="100" cy="100" r="95"/>
        </g>
        <!-- Основное внешнее кольцо -->
        <circle class="compass-ring" cx="100" cy="100" r="90"/>
        <!-- Штрихованное промежуточное кольцо (вращается) -->
        <g>
          <animateTransform attributeName="transform" type="rotate" from="0 100 100" to="360 100 100" dur="55s" repeatCount="indefinite"/>
          <circle class="compass-ring compass-ring--dashed" cx="100" cy="100" r="80" pathLength="360"/>
        </g>
        <!-- Внутреннее кольцо -->
        <circle class="compass-ring compass-ring--inner" cx="100" cy="100" r="70"/>
        <!-- Декоративное тонкое кольцо -->
        <circle class="compass-ring compass-ring--thin" cx="100" cy="100" r="55"/>
        <!-- Внутреннее декоративное кольцо -->
        <circle class="compass-ring" cx="100" cy="100" r="50" style="opacity: 0.2; stroke-width: 0.3;"/>

        <!-- ===== Дуги секторов ===== -->
        <path class="compass-arc" d="M 100 15 A 85 85 0 0 1 185 100"/>
        <path class="compass-arc compass-arc--teal" d="M 185 100 A 85 85 0 0 1 100 185"/>
        <path class="compass-arc" d="M 100 185 A 85 85 0 0 1 15 100"/>
        <path class="compass-arc compass-arc--teal" d="M 15 100 A 85 85 0 0 1 100 15"/>

        <!-- ===== Декоративные ромбы по диагоналям ===== -->
        <polygon class="compass-diamond" points="100,52 104,56 100,60 96,56"/>
        <polygon class="compass-diamond" points="100,140 104,144 100,148 96,144"/>
        <polygon class="compass-diamond" points="52,100 56,104 60,100 56,96"/>
        <polygon class="compass-diamond" points="140,100 144,104 148,100 144,96"/>

        <!-- ===== Треугольники-указатели по сторонам света ===== -->
        <polygon style="fill: var(--color-amber); opacity: 0.5;" points="100,8 96,16 104,16"/>
        <polygon style="fill: var(--color-amber); opacity: 0.5;" points="100,192 96,184 104,184"/>
        <polygon style="fill: var(--color-amber); opacity: 0.5;" points="8,100 16,96 16,104"/>
        <polygon style="fill: var(--color-amber); opacity: 0.5;" points="192,100 184,96 184,104"/>

        <!-- ===== Радиальные линии по диагоналям ===== -->
        <line style="stroke: var(--color-teal); stroke-width: 0.4; opacity: 0.3;" x1="100" y1="100" x2="33" y2="33"/>
        <line style="stroke: var(--color-teal); stroke-width: 0.4; opacity: 0.3;" x1="100" y1="100" x2="167" y2="33"/>
        <line style="stroke: var(--color-teal); stroke-width: 0.4; opacity: 0.3;" x1="100" y1="100" x2="33" y2="167"/>
        <line style="stroke: var(--color-teal); stroke-width: 0.4; opacity: 0.3;" x1="100" y1="100" x2="167" y2="167"/>

        <!-- ===== Метки градусов ===== -->
        <g class="compass-ticks">
          <!-- Основные метки (N, S, E, W) — длинные -->
          <line class="compass-tick" x1="100" y1="3" x2="100" y2="18"/>
          <line class="compass-tick" x1="100" y1="182" x2="100" y2="197"/>
          <line class="compass-tick" x1="3" y1="100" x2="18" y2="100"/>
          <line class="compass-tick" x1="182" y1="100" x2="197" y2="100"/>

          <!-- Метки 45° — средние -->
          <line class="compass-tick compass-tick--minor" x1="100" y1="3" x2="100" y2="15" transform="rotate(45 100 100)"/>
          <line class="compass-tick compass-tick--minor" x1="100" y1="3" x2="100" y2="15" transform="rotate(135 100 100)"/>
          <line class="compass-tick compass-tick--minor" x1="100" y1="3" x2="100" y2="15" transform="rotate(225 100 100)"/>
          <line class="compass-tick compass-tick--minor" x1="100" y1="3" x2="100" y2="15" transform="rotate(315 100 100)"/>

          <!-- Метки 30° / 60° — короткие -->
          <line class="compass-tick compass-tick--micro" x1="100" y1="6" x2="100" y2="16" transform="rotate(30 100 100)"/>
          <line class="compass-tick compass-tick--micro" x1="100" y1="6" x2="100" y2="16" transform="rotate(60 100 100)"/>
          <line class="compass-tick compass-tick--micro" x1="100" y1="6" x2="100" y2="16" transform="rotate(120 100 100)"/>
          <line class="compass-tick compass-tick--micro" x1="100" y1="6" x2="100" y2="16" transform="rotate(150 100 100)"/>
          <line class="compass-tick compass-tick--micro" x1="100" y1="6" x2="100" y2="16" transform="rotate(210 100 100)"/>
          <line class="compass-tick compass-tick--micro" x1="100" y1="6" x2="100" y2="16" transform="rotate(240 100 100)"/>
          <line class="compass-tick compass-tick--micro" x1="100" y1="6" x2="100" y2="16" transform="rotate(300 100 100)"/>
          <line class="compass-tick compass-tick--micro" x1="100" y1="6" x2="100" y2="16" transform="rotate(330 100 100)"/>

          <!-- Метки 15° / 75° / 105° и т.д. — микро -->
          <line class="compass-tick compass-tick--micro" x1="100" y1="8" x2="100" y2="16" transform="rotate(15 100 100)"/>
          <line class="compass-tick compass-tick--micro" x1="100" y1="8" x2="100" y2="16" transform="rotate(75 100 100)"/>
          <line class="compass-tick compass-tick--micro" x1="100" y1="8" x2="100" y2="16" transform="rotate(105 100 100)"/>
          <line class="compass-tick compass-tick--micro" x1="100" y1="8" x2="100" y2="16" transform="rotate(165 100 100)"/>
          <line class="compass-tick compass-tick--micro" x1="100" y1="8" x2="100" y2="16" transform="rotate(195 100 100)"/>
          <line class="compass-tick compass-tick--micro" x1="100" y1="8" x2="100" y2="16" transform="rotate(255 100 100)"/>
          <line class="compass-tick compass-tick--micro" x1="100" y1="8" x2="100" y2="16" transform="rotate(285 100 100)"/>
          <line class="compass-tick compass-tick--micro" x1="100" y1="8" x2="100" y2="16" transform="rotate(345 100 100)"/>
        </g>

        <!-- ===== Подписи сторон света ===== -->
        <text class="compass-label" x="100" y="24">N</text>
        <text class="compass-label" x="100" y="180">S</text>
        <text class="compass-label" x="24" y="100">W</text>
        <text class="compass-label" x="176" y="100">E</text>

        <!-- ===== Градусные подписи ===== -->
        <text style="fill: var(--color-teal); font-family: var(--font-mono); font-size: 6px; opacity: 0.45; text-anchor: middle; dominant-baseline: central;" x="100" y="30">0°</text>
        <text style="fill: var(--color-teal); font-family: var(--font-mono); font-size: 6px; opacity: 0.45; text-anchor: middle; dominant-baseline: central;" x="100" y="174">180°</text>
        <text style="fill: var(--color-teal); font-family: var(--font-mono); font-size: 6px; opacity: 0.45; text-anchor: middle; dominant-baseline: central;" x="30" y="100">270°</text>
        <text style="fill: var(--color-teal); font-family: var(--font-mono); font-size: 6px; opacity: 0.45; text-anchor: middle; dominant-baseline: central;" x="170" y="100">90°</text>

        <!-- ===== Стрелка компаса ===== -->
        <g class="compass-needle">
          <!-- Маятниковое покачивание ±15° -->
          <animateTransform
            attributeName="transform"
            type="rotate"
            values="-15 100 100; 15 100 100; -15 100 100"
            dur="12s"
            repeatCount="indefinite"
          />
          <!-- Северная часть стрелки — более выраженная -->
          <polygon class="compass-needle--north" points="100,18 93,95 100,90 107,95"/>
          <!-- Южная часть стрелки -->
          <polygon class="compass-needle--south" points="100,182 93,105 100,110 107,105"/>
          <!-- Внешнее пульсирующее кольцо центра -->
          <circle class="compass-dot--outer" cx="100" cy="100" r="7">
            <animate attributeName="r" values="7;10;7" dur="2s" repeatCount="indefinite"/>
            <animate attributeName="opacity" values="0.3;0.55;0.3" dur="2s" repeatCount="indefinite"/>
          </circle>
          <!-- Центральная точка -->
          <circle class="compass-dot" cx="100" cy="100" r="3.5">
            <animate attributeName="r" values="3;4.5;3" dur="2s" repeatCount="indefinite"/>
          </circle>
        </g>
      </svg>

      <div class="hero-eyebrow">Сравнение курсов</div>
      <h1>
        Плати по<br /><span class="accent">лучшей цене</span>
      </h1>
      <p class="hero-subtitle">
        Сравниваем курсы пополнения, ваучеров и международных переводов — выбери лучшее предложение
      </p>
    </section>

    <!-- Search -->
    <div class="search-section">
      <div class="search-bar">
        <svg class="search-bar-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
        </svg>
        <input
          type="text"
          id="serviceSearch"
          placeholder="Поиск сервиса... (Steam, Xbox, Roblox...)"
          autocomplete="off"
        />
      </div>
    </div>

    <div class="divider"></div>

    <!-- Categories -->
    <section class="section" id="servicesList">
      {categories.map((category) => (
        <div class="category-block" data-category={category.id}>
          <div class="category-header">
            <h3 class="category-title">
              {category.name}
              <span class="category-count">{category.services.length}</span>
            </h3>
            <a href={`/${category.id}/`} class="category-link">
              Все
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
              </svg>
            </a>
          </div>

          <div class="services-grid">
            {category.services.map((service) => (
              <a
                href={`/${category.id}/${service.id}/`}
                class="service-card"
                data-service-name={service.name.toLowerCase()}
              >
                <div class="card">
                  <div class="service-card-header">
                    <span class="service-name">{service.name}</span>
                    <span class="badge badge--amber">
                      {(() => {
                        const n = service._totalRegions ?? service.regions.length;
                        return `${n} ${pluralizeRegions(n)}`;
                      })()}
                    </span>
                  </div>
                  {service._maxSavings != null && service._maxSavings >= 1 ? (
                    <div class="savings-badge">
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                      </svg>
                      Экономия до {Math.round(service._maxSavings)}%
                    </div>
                  ) : null}

                  <div class="service-regions">
                    {service.regions.slice(0, 3).map((region) => (
                      <span class="service-region">
                        <span class="service-region-flag">{getRegionFlag(region.id)}</span>
                        {region.label}
                      </span>
                    ))}
                    {(() => {
                      const total = service._totalRegions ?? service.regions.length;
                      const remaining = total - 3;
                      return remaining > 0 ? (
                        <span class="service-region service-region--more">+{remaining}</span>
                      ) : null;
                    })()}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </section>

    <!-- Transfers Section -->
    {transferCountries.length > 0 && (
      <>
        <div class="divider"></div>

        <section class="section" id="transfersList">
          <div class="category-block" data-category="transfers">
            <div class="category-header">
              <h3 class="category-title">
                Переводы
                <span class="category-count">{transferCountries.length}</span>
              </h3>
              <a href={`/transfers/`} class="category-link">
                Все
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                </svg>
              </a>
            </div>

            <div class="services-grid">
              {transferCountries.map((country) => {
                // Вычисляем макс экономию по всем методам страны
                const allSavings = country.methods.map(m => m._maxSavings).filter(s => s != null && s >= 1) as number[];
                const maxSavings = allSavings.length > 0 ? Math.max(...allSavings) : null;

                return (
                  <a
                    href={`/transfers/${country.id}/`}
                    class="service-card"
                    data-service-name={country.name.toLowerCase()}
                  >
                    <div class="card">
                      <div class="service-card-header">
                        <span class="service-name">{country.flag} {country.name}</span>
                        <span class="badge badge--amber">
                          {country.methods.length} {country.methods.length === 1 ? 'метод' : country.methods.length < 5 ? 'метода' : 'методов'}
                        </span>
                      </div>
                      {maxSavings != null ? (
                        <div class="savings-badge">
                          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                          </svg>
                          Экономия до {Math.round(maxSavings)}%
                        </div>
                      ) : null}

                      <div class="service-regions">
                        {country.methods.slice(0, 3).map((method) => (
                          <span class="service-region">
                            {method.name}
                          </span>
                        ))}
                      </div>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        </section>
      </>
    )}

    <div class="divider"></div>

    <!-- Why Us Section -->
    <section class="why-section">
      <div class="why-grid">
        <div class="card why-card">
          <span class="why-card-icon">🎯</span>
          <h3>Точное сравнение</h3>
          <p>Реальные цены с учётом всех комиссий и курсов — без округлений и приближений, как есть</p>
        </div>
        <div class="card why-card">
          <span class="why-card-icon">💰</span>
          <h3>Экономия до 30%</h3>
          <p>Найдите лучшую цену и сэкономьте на каждом пополнении — мы показываем разницу в процентах</p>
        </div>
        <div class="card why-card">
          <span class="why-card-icon">🔒</span>
          <h3>Проверенные провайдеры</h3>
          <p>Работаем только с надёжными провайдерами — ваши платежи в безопасности</p>
        </div>
      </div>
    </section>

    <!-- Stats Bar -->
    <div class="stats-bar card">
      <div class="stat-item">
        <span class="stat-value">{totalServices}</span>
        <span class="stat-label">Сервисов</span>
      </div>
      <div class="stat-item">
        <span class="stat-value">{totalProviders}</span>
        <span class="stat-label">Провайдеров</span>
      </div>
      <div class="stat-item">
        <span class="stat-value">{totalRegions}</span>
        <span class="stat-label">{pluralizeRegions(totalRegions)}</span>
      </div>
      <div class="stat-item">
        <span class="stat-value">{transferCountries.length}</span>
        <span class="stat-label">Стран переводов</span>
      </div>
    </div>


    <!-- FAQ Section -->
    <section class="faq-section">
      <h2>Частые вопросы</h2>
      <div class="faq-item">
        <button class="faq-question">
          <span>Что такое PayCompass?</span>
          <span class="faq-icon">+</span>
        </button>
        <div class="faq-answer">
          <p>PayCompass — это сервис сравнения курсов пополнения, ваучеров и международных переводов. Мы агрегируем данные от разных провайдеров, чтобы вы могли найти лучшую цену.</p>
        </div>
      </div>
      <div class="faq-item">
        <button class="faq-question">
          <span>Как часто обновляются курсы?</span>
          <span class="faq-icon">+</span>
        </button>
        <div class="faq-answer">
          <p>Курсы обновляются при каждой сборке сайта. Мы следим за актуальностью данных, чтобы вы всегда видели реальные цены.</p>
        </div>
      </div>
      <div class="faq-item">
        <button class="faq-question">
          <span>Почему цены отличаются у разных провайдеров?</span>
          <span class="faq-icon">+</span>
        </button>
        <div class="faq-answer">
          <p>Каждый провайдер устанавливает свои курсы на основе спроса, региона и внутренних расчётов. Разница может достигать 20-30%, поэтому сравнение помогает сэкономить.</p>
        </div>
      </div>
      <div class="faq-item">
        <button class="faq-question">
          <span>Где можно пополнить по лучшей цене?</span>
          <span class="faq-icon">+</span>
        </button>
        <div class="faq-answer">
          <p>На каждой странице сервиса мы выделяем провайдера с лучшей ценой зелёной меткой «лучший». Нажмите «Перейти» рядом с нужным провайдером, чтобы оформить пополнение.</p>
        </div>
      </div>
    </section>

    <!-- Empty state (hidden by default) -->
    <div class="empty-state" id="emptyState" style="display: none;">
      Ничего не найдено. Попробуй изменить запрос.
    </div>
  </div>

  <!-- Scripts -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // ===== Search =====
      const searchInput = document.getElementById('serviceSearch') as HTMLInputElement | null;
      const servicesList = document.getElementById('servicesList') as HTMLElement | null;
      const transfersList = document.getElementById('transfersList') as HTMLElement | null;
      const emptyState = document.getElementById('emptyState') as HTMLElement | null;
      if (searchInput && servicesList && emptyState) {
        const allCategoryBlocks = [
          ...(servicesList?.querySelectorAll('.category-block') as NodeListOf<HTMLElement> || []),
          ...(transfersList?.querySelectorAll('.category-block') as NodeListOf<HTMLElement> || []),
        ];

        searchInput.addEventListener('input', (e) => {
          const target = e.target as HTMLInputElement;
          const query = target.value.toLowerCase().trim();

          if (!query) {
            allCategoryBlocks.forEach(block => block.style.display = '');
            emptyState.style.display = 'none';
            return;
          }

          let anyVisible = false;

          allCategoryBlocks.forEach(block => {
            const cards = block.querySelectorAll<HTMLElement>('.service-card');
            let categoryHasMatch = false;

            cards.forEach(card => {
              const name = card.getAttribute('data-service-name') || '';
              if (name.includes(query)) {
                card.style.display = '';
                categoryHasMatch = true;
              } else {
                card.style.display = 'none';
              }
            });

            if (categoryHasMatch) {
              block.style.display = '';
              anyVisible = true;
            } else {
              block.style.display = 'none';
            }
          });

          emptyState.style.display = anyVisible ? 'none' : 'block';
        });
      }

      // ===== FAQ Accordion =====
      const faqButtons = document.querySelectorAll('.faq-question');
      faqButtons.forEach(button => {
        button.addEventListener('click', () => {
          const item = button.parentElement;
          if (!item) return;
          const isOpen = item.classList.contains('open');

          // Закрыть все
          document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));

          // Открыть текущий (если был закрыт)
          if (!isOpen) {
            item.classList.add('open');
          }
        });
      });
    });
  </script>
</Layout>
