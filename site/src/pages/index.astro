---
import Layout from '../layouts/Layout.astro';
import { parseAllDataForHome, getRegionFlag } from '../utils/data';

const base = import.meta.env.BASE_URL || '';
const { categories } = parseAllDataForHome();

function pluralizeRegions(n: number): string {
  const abs = Math.abs(n) % 100;
  const n1 = abs % 10;
  if (abs > 10 && abs < 20) return 'регионов';
  if (n1 === 1) return 'регион';
  if (n1 >= 2 && n1 <= 4) return 'региона';
  return 'регионов';
}
---
<Layout 
  title="PayCompass — Сравни курсы, плати меньше" 
  description="Сравниваем курсы пополнения и ваучеров для Steam, PlayStation, App Store и других сервисов. Найди лучшую цену за секунду."
>
  <style>
    /* ===== HERO ===== */
    .hero {
      text-align: center;
      padding: 3rem 0 2.5rem;
    }

    .hero-eyebrow {
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--color-amber);
      margin-bottom: 0.75rem;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
    }

    .hero-eyebrow::before,
    .hero-eyebrow::after {
      content: '';
      width: 24px;
      height: 1px;
      background: var(--color-amber-dim);
      opacity: 0.5;
    }

    .hero h1 {
      font-size: clamp(2.25rem, 6vw, 3.5rem);
      font-weight: 700;
      letter-spacing: -0.05em;
      line-height: 1.05;
      margin-bottom: 0.75rem;
    }

    .hero h1 .accent {
      color: var(--color-amber);
    }

    .hero-subtitle {
      font-size: 1.0625rem;
      color: var(--color-text-muted);
      max-width: 480px;
      margin: 0 auto;
      line-height: 1.6;
    }

    /* ===== SEARCH ===== */
    .search-section {
      margin-bottom: 2.5rem;
    }

    /* ===== SECTIONS ===== */
    .section {
      margin-bottom: 2.5rem;
    }

    .category-block {
      margin-bottom: 2rem;
    }

    .category-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.875rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid var(--color-border);
    }

    .category-title {
      font-family: var(--font-display);
      font-size: 1.125rem;
      font-weight: 600;
      letter-spacing: -0.02em;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .category-count {
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      color: var(--color-text-faint);
      font-weight: 400;
    }

    .category-link {
      color: var(--color-text-muted);
      font-size: 0.75rem;
      font-weight: 500;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      padding: 0.25rem 0.5rem;
      border-radius: var(--radius-sm);
      transition: all var(--transition-fast);
    }

    .category-link:hover {
      color: var(--color-amber);
      background: var(--color-amber-glow);
    }

    /* ===== SERVICE GRID ===== */
    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 0.75rem;
    }

    .service-card {
      text-decoration: none;
      color: inherit;
      display: block;
    }

    .service-card .card {
      height: 100%;
    }

    .service-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.5rem;
    }

    .service-name {
      font-family: var(--font-display);
      font-size: 1rem;
      font-weight: 600;
      letter-spacing: -0.02em;
    }

    .service-regions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem;
    }

    .service-region {
      font-size: 0.6875rem;
      color: var(--color-text-muted);
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      background: var(--color-night-subtle);
      padding: 0.125rem 0.5rem;
      border-radius: 100px;
    }

    .service-region--more {
      color: var(--color-text-faint);
      font-family: var(--font-mono);
    }

    .savings-badge {
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      color: var(--color-success);
      font-weight: 500;
      display: flex;
      align-items: center;
      gap: 0.375rem;
      margin-bottom: 0.5rem;
      padding: 0.1875rem 0.5rem;
      background: var(--color-success-bg);
      border-radius: 100px;
      border: 1px solid rgba(20, 184, 166, 0.15);
      width: fit-content;
    }

    .service-region-flag {
      font-size: 0.8125rem;
    }

    /* ===== EMPTY STATE ===== */
    .empty-state {
      text-align: center;
      padding: 3rem 1rem;
      color: var(--color-text-faint);
      font-size: 0.9375rem;
    }

    /* ===== WHY SECTION ===== */
    .why-section {
      margin-bottom: 2.5rem;
    }

    .why-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }

    .why-card {
      text-align: center;
      padding: 1.5rem 1rem;
    }

    .why-card-icon {
      font-size: 1.75rem;
      margin-bottom: 0.75rem;
      display: block;
    }

    .why-card h3 {
      margin-bottom: 0.375rem;
      font-size: 0.9375rem;
    }

    .why-card p {
      font-size: 0.8125rem;
      color: var(--color-text-muted);
      line-height: 1.5;
    }

    /* ===== STATS BAR ===== */
    .stats-bar {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
      margin-bottom: 2.5rem;
      padding: 1.25rem;
    }

    .stat-item {
      text-align: center;
    }

    .stat-value {
      font-family: var(--font-display);
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--color-amber);
      letter-spacing: -0.03em;
      display: block;
    }

    .stat-label {
      font-size: 0.75rem;
      color: var(--color-text-muted);
      margin-top: 0.125rem;
    }

    /* ===== FAQ SECTION ===== */
    .faq-section {
      margin-bottom: 2.5rem;
    }

    .faq-section h2 {
      text-align: center;
      margin-bottom: 1.5rem;
    }

    .faq-item {
      border-bottom: 1px solid var(--color-border);
    }

    .faq-question {
      width: 100%;
      background: none;
      border: none;
      color: var(--color-text);
      font-family: var(--font-display);
      font-size: 0.9375rem;
      font-weight: 600;
      text-align: left;
      padding: 1rem 0;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
    }

    .faq-question:hover {
      color: var(--color-amber);
    }

    .faq-icon {
      flex-shrink: 0;
      transition: transform var(--transition-base);
      color: var(--color-text-faint);
    }

    .faq-item.open .faq-icon {
      transform: rotate(45deg);
    }

    .faq-answer {
      max-height: 0;
      overflow: hidden;
      transition: max-height var(--transition-slow), padding var(--transition-slow);
    }

    .faq-item.open .faq-answer {
      max-height: 300px;
      padding-bottom: 1rem;
    }

    .faq-answer p {
      font-size: 0.875rem;
      color: var(--color-text-muted);
      line-height: 1.6;
    }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 640px) {
      .hero {
        padding: 2rem 0 1.5rem;
      }
      .services-grid {
        grid-template-columns: 1fr;
      }
      .why-grid {
        grid-template-columns: 1fr;
      }
      .stats-bar {
        grid-template-columns: repeat(2, 1fr);
      }
    }
  </style>

  <div>
    <!-- Hero -->
    <section class="hero">
      <div class="hero-eyebrow">Сравнение курсов</div>
      <h1>
        Плати по<br /><span class="accent">лучшей цене</span>
      </h1>
      <p class="hero-subtitle">
        Сравниваем курсы пополнения и ваучеров для игровых и цифровых сервисов — выбери лучшее предложение
      </p>
    </section>

    <!-- Search -->
    <div class="search-section">
      <div class="search-bar">
        <svg class="search-bar-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
        </svg>
        <input
          type="text"
          id="serviceSearch"
          placeholder="Поиск сервиса... (Steam, Xbox, Roblox...)"
          autocomplete="off"
        />
      </div>
    </div>

    <div class="divider"></div>

    <!-- Categories -->
    <section class="section" id="servicesList">
      {categories.map((category) => (
        <div class="category-block" data-category={category.id}>
          <div class="category-header">
            <h3 class="category-title">
              {category.name}
              <span class="category-count">{category.services.length}</span>
            </h3>
            <a href={`/${category.id}/`} class="category-link">
              Все
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
              </svg>
            </a>
          </div>

          <div class="services-grid">
            {category.services.map((service) => (
              <a
                href={`/${category.id}/${service.id}/`}
                class="service-card"
                data-service-name={service.name.toLowerCase()}
              >
                <div class="card">
                  <div class="service-card-header">
                    <span class="service-name">{service.name}</span>
                    <span class="badge badge--amber">
                      {(() => {
                        const n = service._totalRegions ?? service.regions.length;
                        return `${n} ${pluralizeRegions(n)}`;
                      })()}
                    </span>
                  </div>
                  {service._maxSavings != null && service._maxSavings >= 1 ? (
                    <div class="savings-badge">
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                      </svg>
                      Экономия до {Math.round(service._maxSavings)}%
                    </div>
                  ) : null}

                  <div class="service-regions">
                    {service.regions.slice(0, 3).map((region) => (
                      <span class="service-region">
                        <span class="service-region-flag">{getRegionFlag(region.id)}</span>
                        {region.label}
                      </span>
                    ))}
                    {(() => {
                      const total = service._totalRegions ?? service.regions.length;
                      const remaining = total - 3;
                      return remaining > 0 ? (
                        <span class="service-region service-region--more">+{remaining}</span>
                      ) : null;
                    })()}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </section>

    <div class="divider"></div>

    <!-- Why Us Section -->
    <section class="why-section">
      <div class="why-grid">
        <div class="card why-card">
          <span class="why-card-icon">🎯</span>
          <h3>Точное сравнение</h3>
          <p>Реальные цены с учётом всех комиссий и курсов — без округлений и приближений, как есть</p>
        </div>
        <div class="card why-card">
          <span class="why-card-icon">💰</span>
          <h3>Экономия до 30%</h3>
          <p>Найдите лучшую цену и сэкономьте на каждом пополнении — мы показываем разницу в процентах</p>
        </div>
        <div class="card why-card">
          <span class="why-card-icon">🔒</span>
          <h3>Проверенные провайдеры</h3>
          <p>Работаем только с надёжными провайдерами — ваши платежи в безопасности</p>
        </div>
      </div>
    </section>

    <!-- Stats Bar -->
    <div class="stats-bar card">
      <div class="stat-item">
        <span class="stat-value">50+</span>
        <span class="stat-label">Сервисов</span>
      </div>
      <div class="stat-item">
        <span class="stat-value">15+</span>
        <span class="stat-label">Провайдеров</span>
      </div>
      <div class="stat-item">
        <span class="stat-value">30+</span>
        <span class="stat-label">Регионов</span>
      </div>
      <div class="stat-item">
        <span class="stat-value">24/7</span>
        <span class="stat-label">Актуальные курсы</span>
      </div>
    </div>


    <!-- FAQ Section -->
    <section class="faq-section">
      <h2>Частые вопросы</h2>
      <div class="faq-item">
        <button class="faq-question">
          <span>Что такое PayCompass?</span>
          <span class="faq-icon">+</span>
        </button>
        <div class="faq-answer">
          <p>PayCompass — это сервис сравнения курсов пополнения и ваучеров для игровых и цифровых сервисов. Мы агрегируем данные от разных провайдеров, чтобы вы могли найти лучшую цену.</p>
        </div>
      </div>
      <div class="faq-item">
        <button class="faq-question">
          <span>Как часто обновляются курсы?</span>
          <span class="faq-icon">+</span>
        </button>
        <div class="faq-answer">
          <p>Курсы обновляются при каждой сборке сайта. Мы следим за актуальностью данных, чтобы вы всегда видели реальные цены.</p>
        </div>
      </div>
      <div class="faq-item">
        <button class="faq-question">
          <span>Почему цены отличаются у разных провайдеров?</span>
          <span class="faq-icon">+</span>
        </button>
        <div class="faq-answer">
          <p>Каждый провайдер устанавливает свои курсы на основе спроса, региона и внутренних расчётов. Разница может достигать 20-30%, поэтому сравнение помогает сэкономить.</p>
        </div>
      </div>
      <div class="faq-item">
        <button class="faq-question">
          <span>Где можно пополнить по лучшей цене?</span>
          <span class="faq-icon">+</span>
        </button>
        <div class="faq-answer">
          <p>На каждой странице сервиса мы выделяем провайдера с лучшей ценой зелёной меткой «лучший». Нажмите «Перейти» рядом с нужным провайдером, чтобы оформить пополнение.</p>
        </div>
      </div>
    </section>

    <!-- Empty state (hidden by default) -->
    <div class="empty-state" id="emptyState" style="display: none;">
      Ничего не найдено. Попробуй изменить запрос.
    </div>
  </div>

  <!-- Scripts -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // ===== Search =====
      const searchInput = document.getElementById('serviceSearch') as HTMLInputElement | null;
      const servicesList = document.getElementById('servicesList') as HTMLElement | null;
      const emptyState = document.getElementById('emptyState') as HTMLElement | null;
      if (searchInput && servicesList && emptyState) {
        const categoryBlocks = servicesList.querySelectorAll('.category-block') as NodeListOf<HTMLElement>;

        searchInput.addEventListener('input', (e) => {
          const target = e.target as HTMLInputElement;
          const query = target.value.toLowerCase().trim();

          if (!query) {
            categoryBlocks.forEach(block => block.style.display = '');
            emptyState.style.display = 'none';
            return;
          }

          let anyVisible = false;

          categoryBlocks.forEach(block => {
            const cards = block.querySelectorAll<HTMLElement>('.service-card');
            let categoryHasMatch = false;

            cards.forEach(card => {
              const name = card.getAttribute('data-service-name') || '';
              if (name.includes(query)) {
                card.style.display = '';
                categoryHasMatch = true;
              } else {
                card.style.display = 'none';
              }
            });

            if (categoryHasMatch) {
              block.style.display = '';
              anyVisible = true;
            } else {
              block.style.display = 'none';
            }
          });

          emptyState.style.display = anyVisible ? 'none' : 'block';
        });
      }

      // ===== FAQ Accordion =====
      const faqButtons = document.querySelectorAll('.faq-question');
      faqButtons.forEach(button => {
        button.addEventListener('click', () => {
          const item = button.parentElement;
          const isOpen = item.classList.contains('open');

          // Закрыть все
          document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));

          // Открыть текущий (если был закрыт)
          if (!isOpen) {
            item.classList.add('open');
          }
        });
      });
    });
  </script>
</Layout>
