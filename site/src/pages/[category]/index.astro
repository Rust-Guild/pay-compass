---
import Layout from '../../layouts/Layout.astro';
import { parseAllData, findBestProvider, getRegionFlag, type CategoryData, type ServiceData, type RegionData } from '../../utils/data';
import type { GetStaticPathsItem } from 'astro';

export async function getStaticPaths() {
  const { categories } = parseAllData();
  const paths: GetStaticPathsItem[] = [];

  for (const category of categories) {
    paths.push({
      params: { category: category.id },
      props: { category },
    });
  }

  return paths;
}

const { category } = Astro.props as { category: CategoryData };
const title = `${category.name} — лучшие курсы платежей | PayCompass`;
const description = `Лучшие курсы платежей и переводов для ${category.name}: ${category.services.map(s => s.name).join(', ')}. Сравнивайте и экономьте!`;
---
<Layout title={title} description={description}>
  <style>
    .page-header {
      margin-bottom: 2.5rem;
    }

    .page-header h1 {
      margin-bottom: 0.5rem;
    }

    .services-list {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .service-row {
      display: flex;
      gap: 1.25rem;
      align-items: stretch;
    }

    .service-info {
      flex: 1;
      min-width: 0;
    }

    .service-link {
      text-decoration: none;
      color: inherit;
      display: block;
    }

    .service-link .card {
      height: 100%;
      display: flex;
      flex-direction: column;
    }

    .service-link:hover .service-title {
      color: var(--color-primary-light);
    }

    .service-title {
      font-size: 1.125rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      margin-bottom: 0.75rem;
      transition: color var(--transition-fast);
    }

    .region-list {
      display: flex;
      flex-direction: column;
      gap: 0.625rem;
    }

    .region-item {
      font-size: 0.8125rem;
      color: var(--color-text-muted);
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .region-item-top {
      display: flex;
      align-items: center;
      gap: 0.375rem;
    }

    .region-item-detail {
      padding-left: 1.25rem;
      font-size: 0.75rem;
      color: var(--color-text-faint);
    }

    .best-price-card {
      flex-shrink: 0;
      min-width: 220px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .best-price-label {
      font-size: 0.6875rem;
      font-weight: 600;
      color: var(--color-success);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 0.5rem;
      display: flex;
      align-items: center;
      gap: 0.375rem;
    }

    .best-price-value {
      font-size: 1.75rem;
      font-weight: 800;
      letter-spacing: -0.04em;
      color: var(--color-success);
      font-family: var(--font-mono);
      line-height: 1.1;
    }

    .best-price-provider {
      font-size: 0.8125rem;
      color: var(--color-text-muted);
      margin-top: 0.375rem;
    }

    .best-price-savings {
      font-size: 0.75rem;
      color: var(--color-success);
      margin-top: 0.5rem;
      display: flex;
      align-items: center;
      gap: 0.25rem;
    }

    .best-price-cta {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      margin-top: 0.75rem;
      font-size: 0.8125rem;
      font-weight: 600;
      color: var(--color-primary-light);
      text-decoration: none;
      transition: all var(--transition-fast);
    }

    .best-price-cta:hover {
      color: var(--color-accent-light);
    }

    .best-price-cta svg {
      transition: transform var(--transition-fast);
    }

    .best-price-cta:hover svg {
      transform: translateX(3px);
    }

    @media (max-width: 768px) {
      .service-row {
        flex-direction: column;
      }
      .best-price-card {
        min-width: unset;
      }
    }
  </style>

  <div>
    <a href="/" class="link-back">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>
      </svg>
      Главная
    </a>

    <div class="page-header">
      <h1>{category.name}</h1>
      <p class="subtitle">
        Сравниваем курсы платежей — выберите лучшее предложение для каждого сервиса
      </p>
    </div>

    <div class="services-list">
      {category.services.map((service) => {
        // Находим лучшую цену по всем регионам и номиналам сервиса
        let bestPrice: { provider: string; price: number; region: string; denom: string } | null = null;
        let worstPrice: number = 0;

        for (const region of service.regions) {
          if (region.topups) {
            for (const topup of region.topups) {
              for (const prov of topup.providers) {
                if (bestPrice === null || prov.price < bestPrice.price) {
                  bestPrice = { provider: prov.name, price: prov.price, region: region.label, denom: topup.currency };
                }
                if (prov.price > worstPrice) worstPrice = prov.price;
              }
            }
          }
          if (region.vouchers) {
            for (const voucher of region.vouchers) {
              for (const prov of voucher.providers) {
                if (bestPrice === null || prov.price < bestPrice.price) {
                  bestPrice = { provider: prov.name, price: prov.price, region: region.label, denom: voucher.name };
                }
                if (prov.price > worstPrice) worstPrice = prov.price;
              }
            }
          }
        }

        const savingsPercent = bestPrice && worstPrice > bestPrice.price
          ? ((worstPrice - bestPrice.price) / worstPrice * 100)
          : 0;

        return (
          <div class="service-row">
            <div class="service-info">
              <a href={`/${category.id}/${service.id}/`} class="service-link">
                <div class="card">
                  <h2 class="service-title">{service.name}</h2>

                  <div class="region-list">
                    {service.regions.map((region) => (
                      <div class="region-item">
                        <div class="region-item-top">
                          <span>{getRegionFlag(region.id)}</span>
                          <span>{region.label}</span>
                          <span class="badge">оплата {region.payCurrency}</span>
                        </div>

                        {region.type === 'topups' && region.topups && region.topups.length > 0 && (
                          <div class="region-item-detail">
                            Зачисление: {region.topups.map((t) => t.currency).join(', ')}
                          </div>
                        )}

                        {region.type === 'vouchers' && region.vouchers && region.vouchers.length > 0 && (
                          <div class="region-item-detail">
                            Ваучеры: {region.vouchers.map((v) => v.name).join(', ')}
                          </div>
                        )}
                      </div>
                    ))}
                  </div>
                </div>
              </a>
            </div>

            {bestPrice && (
              <div class="best-price-card">
                <div class="best-price-label">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                  </svg>
                  Лучшая цена
                </div>
                <div class="best-price-value mono">
                  {bestPrice.price.toFixed(2)} ₽
                </div>
                <div class="best-price-provider">{bestPrice.provider}</div>
                {savingsPercent > 0 && (
                  <div class="best-price-savings">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
                      <polyline points="17 6 23 6 23 12"/>
                    </svg>
                    экономия до {savingsPercent.toFixed(1)}%
                  </div>
                )}
                <a href={`/${category.id}/${service.id}/`} class="best-price-cta">
                  Подробнее
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                  </svg>
                </a>
              </div>
            )}
          </div>
        );
      })}
    </div>

    <!-- Structured data -->
    <script type="application/ld+json" define:vars={{ c: category }}>
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": c.name,
      "description": `Лучшие курсы платежей и переводов для ${c.name}`,
      "numberOfItems": c.services.length,
      "itemListElement": c.services.map((s, i) => ({
        "@type": "Service",
        "position": i + 1,
        "name": s.name,
        "url": `/${c.id}/${s.id}/`
      }))
    }
    </script>
  </div>
</Layout>
