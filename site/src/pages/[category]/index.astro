---
import Layout from '../../layouts/Layout.astro';
import { parseAllData, getRegionFlag, type CategoryData } from '../../utils/data';
import type { GetStaticPathsItem } from 'astro';

export async function getStaticPaths() {
  const { categories } = parseAllData();
  const paths: GetStaticPathsItem[] = [];

  for (const category of categories) {
    paths.push({
      params: { category: category.id },
      props: { category },
    });
  }

  return paths;
}

const { category } = Astro.props as { category: CategoryData };
const base = import.meta.env.BASE_URL || '';
const title = `${category.name} — курсы платежей | PayCompass`;
const description = `Лучшие курсы для ${category.name}: ${category.services.map(s => s.name).join(', ')}. Сравнивайте и экономьте!`;
const siteUrl = import.meta.env.SITE || 'https://paycompass.ru';
const pageUrl = `${siteUrl}${base}/${category.id}/`;
---
<Layout title={title} description={description}>
  <!-- JSON-LD для страницы категории -->
  <script type="application/ld+json">
  {JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": title,
    "description": description,
    "url": pageUrl,
    "inLanguage": "ru",
    "numberOfItems": category.services.length,
    "itemListElement": category.services.map((s, i) => ({
      "@type": "WebPage",
      "position": i + 1,
      "name": s.name,
      "url": `${pageUrl}${s.id}/`
    }))
  })}
  </script>
  <style>
    .page-header {
      margin-bottom: 2rem;
    }

    .page-header h1 {
      margin-bottom: 0.375rem;
    }

    .services-list {
      display: flex;
      flex-direction: column;
      gap: 0.875rem;
    }

    .service-link {
      text-decoration: none;
      color: inherit;
      display: block;
    }

    .service-link:hover .service-title {
      color: var(--color-amber);
    }

    .service-title {
      font-family: var(--font-display);
      font-size: 1.0625rem;
      font-weight: 600;
      letter-spacing: -0.02em;
      margin-bottom: 0.5rem;
      transition: color var(--transition-fast);
    }

    .region-list {
      display: flex;
      flex-direction: column;
      gap: 0.375rem;
    }

    .region-item {
      font-size: 0.8125rem;
      color: var(--color-text-muted);
      display: flex;
      align-items: center;
      gap: 0.375rem;
      padding: 0.25rem 0;
    }

    .provider-icons {
      margin-left: auto;
      display: flex;
      align-items: center;
      gap: 0.25rem;
    }

    .provider-icon {
      width: 20px;
      height: 20px;
      border-radius: 50%;
      object-fit: cover;
      border: 1px solid var(--color-border);
    }

    @media (max-width: 640px) {
      .provider-icon {
        width: 16px;
        height: 16px;
      }
    }
  </style>

  <div>
    <a href="/" class="link-back">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>
      </svg>
      Главная
    </a>

    <div class="page-header">
      <h1>{category.name}</h1>
      <p class="subtitle">
        Сравниваем курсы платежей — выберите лучшее предложение для каждого сервиса
      </p>
    </div>

    <div class="services-list">
      {category.services.map((service) => {
        // Собираем уникальных провайдеров для каждого региона
        const regionProviders: any = {};

        for (const region of service.regions) {
          const provMap: any = {};

          if (region.topups) {
            for (const topup of region.topups) {
              for (const provider of topup.providers) {
                if (!provMap[provider.key]) {
                  provMap[provider.key] = { logo: provider.logo, name: provider.name };
                }
              }
            }
          }
          if (region.vouchers) {
            for (const voucher of region.vouchers) {
              for (const provider of voucher.providers) {
                if (!provMap[provider.key]) {
                  provMap[provider.key] = { logo: provider.logo, name: provider.name };
                }
              }
            }
          }

          regionProviders[region.label] = Object.values(provMap);
        }

        return (
          <div>
            <a href={`/${category.id}/${service.id}/`} class="service-link">
              <div class="card">
                <h2 class="service-title">{service.name}</h2>

                <div class="region-list">
                  {service.regions.map((region) => {
                    const providers = regionProviders[region.label] || [];
                    const topProviders = providers.slice(0, 3);
                    return (
                      <div class="region-item">
                        <span>{getRegionFlag(region.id)}</span>
                        <span>{region.label}</span>
                        <span class="badge">оплата {region.payCurrency}</span>
                        {topProviders.length > 0 && (
                          <div class="provider-icons">
                            {topProviders.map((p: any) => (
                              <img src={p.logo} alt={p.name} class="provider-icon" loading="lazy" />
                            ))}
                          </div>
                        )}
                      </div>
                    );
                  })}
                </div>
              </div>
            </a>
          </div>
        );
      })}
    </div>

    <!-- Structured data -->
    <script type="application/ld+json" define:vars={{ c: category }}>
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": c.name,
      "description": `Лучшие курсы платежей для ${c.name}`,
      "numberOfItems": c.services.length,
      "itemListElement": c.services.map((s, i) => ({
        "@type": "Service",
        "position": i + 1,
        "name": s.name,
        "url": `/${c.id}/${s.id}/`
      }))
    }
    </script>
  </div>
</Layout>
