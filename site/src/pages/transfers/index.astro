---
import Layout from '../../layouts/Layout.astro';
import { parseTransferData, type TransferCountryData } from '../../utils/data';
import type { GetStaticPathsItem } from 'astro';

const { countries } = parseTransferData();
const base = import.meta.env.BASE_URL || '';
const title = 'Переводы — сравнение курсов | PayCompass';
const description = `Сравните курсы переводов в разные страны: Армения, Китай, Казахстан, Узбекистан и другие. Найдите лучшую цену!`;
const siteUrl = import.meta.env.SITE || 'https://paycompass.ru';
const pageUrl = `${siteUrl}${base}transfers/`;
---
<Layout title={title} description={description}>
  <!-- JSON-LD -->
  <script type="application/ld+json">
  {JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": title,
    "description": description,
    "url": pageUrl,
    "inLanguage": "ru",
    "numberOfItems": countries.length,
    "itemListElement": countries.map((c, i) => ({
      "@type": "WebPage",
      "position": i + 1,
      "name": c.name,
      "url": `${pageUrl}${c.id}/`
    }))
  })}
  </script>
  <style>
    .page-header {
      margin-bottom: 2rem;
    }

    .page-header h1 {
      margin-bottom: 0.375rem;
    }

    .countries-list {
      display: flex;
      flex-direction: column;
      gap: 0.875rem;
    }

    .country-link {
      text-decoration: none;
      color: inherit;
      display: block;
    }

    .country-link:hover .country-title {
      color: var(--color-amber);
    }

    .country-title {
      font-family: var(--font-display);
      font-size: 1.0625rem;
      font-weight: 600;
      letter-spacing: -0.02em;
      margin-bottom: 0.5rem;
      transition: color var(--transition-fast);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .country-flag {
      font-size: 1.25rem;
    }

    .method-list {
      display: flex;
      flex-direction: column;
      gap: 0.375rem;
    }

    .method-item {
      font-size: 0.8125rem;
      color: var(--color-text-muted);
      display: flex;
      align-items: center;
      gap: 0.375rem;
      padding: 0.25rem 0;
    }

    .provider-icons {
      margin-left: auto;
      display: flex;
      align-items: center;
      gap: 0.25rem;
    }

    .provider-icon {
      width: 20px;
      height: 20px;
      border-radius: 50%;
      object-fit: cover;
      border: 1px solid var(--color-border);
    }

    @media (max-width: 640px) {
      .provider-icon {
        width: 16px;
        height: 16px;
      }
    }
  </style>

  <div>
    <a href="/" class="link-back">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>
      </svg>
      Главная
    </a>

    <div class="page-header">
      <h1>Переводы</h1>
      <p class="subtitle">
        Сравниваем курсы переводов — выберите лучшее предложение для каждой страны
      </p>
    </div>

    <div class="countries-list">
      {countries.map((country) => {
        // Собираем уникальных провайдеров для каждого метода
        const methodProviders: any = {};

        for (const method of country.methods) {
          const provMap: any = {};
          for (const provider of method.providers) {
            if (!provMap[provider.key]) {
              provMap[provider.key] = { logo: provider.logo, name: provider.name };
            }
          }
          methodProviders[method.name] = Object.values(provMap);
        }

        return (
          <div>
            <a href={`/transfers/${country.id}/`} class="country-link">
              <div class="card">
                <h2 class="country-title">
                  <span class="country-flag">{country.flag}</span>
                  {country.name}
                </h2>

                <div class="method-list">
                  {country.methods.map((method) => {
                    const providers = methodProviders[method.name] || [];
                    const topProviders = providers.slice(0, 3);
                    return (
                      <div class="method-item">
                        <span>{method.name}</span>
                        <span class="badge">оплата {method.payCurrency}</span>
                        {topProviders.length > 0 && (
                          <div class="provider-icons">
                            {topProviders.map((p: any) => (
                              <img src={p.logo} alt={p.name} class="provider-icon" loading="lazy" />
                            ))}
                          </div>
                        )}
                      </div>
                    );
                  })}
                </div>
              </div>
            </a>
          </div>
        );
      })}
    </div>

    <!-- Structured data -->
    <script type="application/ld+json" define:vars={{ c: countries }}>
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "Переводы — сравнение курсов",
      "description": `Сравнение курсов переводов в ${c.length} страны`,
      "url": "${pageUrl}",
      "inLanguage": "ru"
    }
    </script>
  </div>
</Layout>
