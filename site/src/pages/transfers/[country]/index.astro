---
import Layout from '../../../layouts/Layout.astro';
import { parseTransferData } from '../../../utils/data';

const base = import.meta.env.BASE_URL || '';

export async function getStaticPaths() {
  const { countries } = parseTransferData();
  return countries.map((country) => ({
    params: { country: country.id },
    props: { country },
  }));
}

const { country } = Astro.props;

const title = `${country.flag} Переводы в ${country.name} — сравнение курсов | PayCompass`;
const description = `Сравните курсы переводов в ${country.name}: ${country.methods.map(m => m.name).join(', ')}. Найдите лучшую цену!`;
const siteUrl = import.meta.env.SITE || 'https://paycompass.ru';
const pageUrl = `${siteUrl}${base}transfers/${country.id}/`;
---
<Layout title={title} description={description}>
  <!-- JSON-LD -->
  <script type="application/ld+json">
  {JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": title,
    "description": description,
    "url": pageUrl,
    "inLanguage": "ru",
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Главная", "item": siteUrl },
        { "@type": "ListItem", "position": 2, "name": "Переводы", "item": `${siteUrl}${base}transfers/` },
        { "@type": "ListItem", "position": 3, "name": country.name, "item": pageUrl }
      ]
    }
  })}
  </script>

  <style>
    .page-header {
      margin-bottom: 3rem;
    }

    .page-header h1 {
      margin-bottom: 0.375rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    /* ===== BREADCRUMB ===== */
    .breadcrumb {
      display: flex;
      align-items: center;
      gap: 0.375rem;
      font-size: 0.8125rem;
      margin-bottom: 0.875rem;
    }

    .breadcrumb a {
      color: var(--color-text-muted);
      text-decoration: none;
      transition: color var(--transition-fast);
    }

    .breadcrumb a:hover {
      color: var(--color-amber);
    }

    .breadcrumb-sep {
      color: var(--color-text-faint);
      font-size: 0.6875rem;
    }

    .breadcrumb-current {
      color: var(--color-text);
      font-weight: 500;
    }

    .country-flag-large {
      font-size: 1.5rem;
    }

    /* ===== REGION SECTION ===== */
    .region-section {
      margin-bottom: 2rem;
    }

    .region-header {
      margin-bottom: 0.875rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid var(--color-border);
    }

    .region-header h2 {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 1.0625rem;
      margin-bottom: 0.25rem;
    }

    .region-meta {
      font-size: 0.8125rem;
      color: var(--color-text-muted);
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.25rem;
    }

    /* ===== DENOM BLOCK ===== */
    .denom-block {
      margin-bottom: 1.25rem;
    }

    .denom-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.625rem;
      flex-wrap: wrap;
      gap: 0.375rem;
    }

    .denom-title {
      font-family: var(--font-display);
      font-size: 0.9375rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .best-hint {
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      color: var(--color-success);
      font-weight: 500;
      display: flex;
      align-items: center;
      gap: 0.25rem;
      padding: 0.1875rem 0.5rem;
      background: var(--color-success-bg);
      border-radius: 100px;
      border: 1px solid rgba(20, 184, 166, 0.15);
    }

    /* ===== TABLE WRAPPER ===== */
    .price-table-wrapper {
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      overflow: hidden;
      background: var(--color-surface);
    }

    .price-table {
      margin-top: 0;
    }

    .price-table th {
      background: var(--color-night-elevated);
      padding: 0.5rem 0.75rem;
      font-size: 0.625rem;
    }

    .price-table td {
      padding: 0.5rem 0.75rem;
      font-size: 0.8125rem;
    }

    .provider-cell {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .provider-name {
      font-weight: 500;
    }

    .best-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      font-family: var(--font-mono);
      font-size: 0.625rem;
      font-weight: 500;
      color: var(--color-success);
      background: var(--color-success-bg);
      padding: 0.125rem 0.375rem;
      border-radius: 100px;
      border: 1px solid rgba(20, 184, 166, 0.2);
    }

    .price-cell {
      font-weight: 600;
      font-family: var(--font-mono);
      font-size: 0.875rem;
      letter-spacing: -0.01em;
    }

    .take-cell {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--color-text-muted);
    }

    .rate-cell {
      font-family: var(--font-mono);
      font-size: 0.8125rem;
      font-weight: 600;
      letter-spacing: -0.01em;
    }

    .diff-cell {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      font-weight: 500;
    }

    .diff-best {
      color: var(--color-text-muted);
    }

    .diff-worse {
      color: #f87171;
    }

    /* ===== DIFF BAR VISUAL INDICATOR ===== */
    .diff-bar-wrapper {
      display: flex;
      flex-direction: column;
      gap: 0.375rem;
    }

    .diff-bar {
      height: 8px;
      background: rgba(248, 113, 113, 0.08);
      border-radius: 4px;
      overflow: hidden;
    }

    .diff-bar-fill {
      height: 100%;
      border-radius: 4px;
      transition: width var(--transition-base);
      min-width: 4px;
    }

    .diff-bar-fill--worse {
      background: linear-gradient(90deg, #f87171, #ef4444);
      box-shadow: 0 0 6px rgba(248, 113, 113, 0.4);
    }

    .medal-emoji {
      margin-right: 0.25rem;
      font-size: 1rem;
    }

    .action-cell {
      text-align: right;
    }

    .btn-go {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      padding: 0.4375rem 0.875rem;
      background: var(--color-amber);
      color: var(--color-night);
      border-radius: var(--radius-sm);
      font-size: 0.75rem;
      font-weight: 600;
      text-decoration: none;
      transition: all var(--transition-fast);
      box-shadow: 0 2px 8px rgba(245, 158, 11, 0.2);
    }

    .btn-go:hover {
      background: var(--color-amber-dim);
      box-shadow: 0 4px 16px rgba(245, 158, 11, 0.35);
      transform: translateY(-1px);
    }

    .row-best {
      background: var(--color-success-bg) !important;
    }

    .row-best:hover {
      background: rgba(20, 184, 166, 0.15) !important;
    }

    /* ===== RESPONSIVE: TABLE → CARDS ===== */
    @media (max-width: 640px) {
      .denom-header {
        flex-direction: column;
        align-items: flex-start;
      }
      .region-meta {
        font-size: 0.75rem;
      }

      /* Скрываем заголовки таблицы */
      .price-table thead {
        display: none;
      }

      /* Трансформируем таблицу в карточки */
      .price-table,
      .price-table tbody,
      .price-table tr,
      .price-table td {
        display: block;
      }

      .price-table {
        font-size: 0.8125rem;
      }

      .price-table-wrapper {
        overflow: visible;
        border: none;
        background: transparent;
      }

      /* Каждая строка = карточка */
      .price-table tr {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        margin-bottom: 0.75rem;
        padding: 0.75rem;
      }

      .price-table tr:last-child {
        margin-bottom: 0;
      }

      .price-table tr.row-best {
        border-color: rgba(20, 184, 166, 0.3);
        background: var(--color-success-bg);
      }

      /* Ячейки внутри карточки */
      .price-table td {
        padding: 0.25rem 0;
        border-bottom: none;
        display: flex;
        justify-content: space-between;
        align-items: center;
        text-align: right;
      }

      /* Подписи колонок через data-атрибуты */
      .price-table td::before {
        content: attr(data-label);
        font-weight: 500;
        color: var(--color-text-muted);
        font-size: 0.75rem;
        text-align: left;
        flex-shrink: 0;
        margin-right: 1rem;
      }

      /* Первая ячейка (провайдер) = заголовок карточки */
      .price-table td:first-child {
        display: block;
        padding-bottom: 0.5rem;
        margin-bottom: 0.5rem;
        border-bottom: 1px solid var(--color-border);
        text-align: left;
      }
      .price-table td:first-child::before {
        display: none;
      }

      /* Последняя ячейка (действие) на всю ширину */
      .action-cell {
        text-align: left !important;
      }
      .action-cell::before {
        display: none !important;
      }
      .action-cell .btn-go {
        width: 100%;
        justify-content: center;
      }
    }

    /* ===== UPDATE INFO ===== */
    .update-info {
      display: flex;
      align-items: center;
      gap: 0.375rem;
      font-size: 0.8125rem;
      color: var(--color-text-muted);
      margin-bottom: 1.5rem;
      padding: 0.5rem 0.75rem;
      background: var(--color-surface);
      border-radius: var(--radius-sm);
      border: 1px solid var(--color-border);
    }

    /* ===== SEO CONTENT ===== */
    .seo-content {
      margin-bottom: 2rem;
      padding: 1.25rem;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
    }

    .seo-content h2 {
      font-size: 1.0625rem;
      margin-bottom: 0.625rem;
      margin-top: 1rem;
    }

    .seo-content h2:first-child {
      margin-top: 0;
    }

    .seo-content p {
      font-size: 0.875rem;
      line-height: 1.6;
      color: var(--color-text-muted);
      margin-bottom: 0.75rem;
    }

    .seo-content ol {
      font-size: 0.875rem;
      line-height: 1.6;
      color: var(--color-text-muted);
      padding-left: 1.25rem;
      margin-bottom: 0.75rem;
    }

    .seo-content ol li {
      margin-bottom: 0.375rem;
    }
  </style>

  <div>
    <a href="/" class="link-back">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>
      </svg>
      Главная
    </a>

    <!-- Breadcrumb -->
    <div class="breadcrumb">
      <a href="/transfers/">Переводы</a>
      <span class="breadcrumb-sep">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m9 18 6-6-6-6"/>
        </svg>
      </span>
      <span class="breadcrumb-current">{country.name}</span>
    </div>

    <div class="page-header">
      <h1>
        <span class="country-flag-large">{country.flag}</span>
        Переводы в {country.name}
      </h1>
      <p class="subtitle">
        Сравнивайте цены провайдеров и выбирайте лучший курс
      </p>
    </div>

    {country.methods.map((method) => {
      // Вычисляем курсы для каждого провайдера
      const providersWithRates = method.providers
        .filter(p => p.take > 0)
        .map(p => ({
          ...p,
          calculatedRate: p.price / p.take
        }))
        .sort((a, b) => a.calculatedRate - b.calculatedRate);

      if (providersWithRates.length === 0) return null;

      const bestRate = providersWithRates[0].calculatedRate;
      const worstRate = providersWithRates[providersWithRates.length - 1].calculatedRate;
      const savingsPercent = worstRate > bestRate ? ((worstRate - bestRate) / bestRate * 100) : 0;

      // Определяем позицию и разницу для каждого провайдера
      const providersWithRank = providersWithRates.map((p, idx) => {
        const diffPercent = p.calculatedRate != null && bestRate > 0
          ? ((p.calculatedRate - bestRate) / bestRate * 100)
          : 0;
        return { ...p, rank: idx + 1, diffPercent };
      });

      // Максимальная разница для масштабирования полоски
      const maxDiff = Math.max(...providersWithRank.map(p => p.diffPercent), 1);

      return (
        <div class="region-section">
          <div class="region-header">
            <h2>
              <span>{method.name}</span>
            </h2>
            <div class="region-meta">
              Оплата: <strong>{method.payCurrency}</strong> · Получаете: <strong>{method.receiveCurrency}</strong>
              {savingsPercent > 0 && (
                <span class="best-hint" style="margin-left: 0.5rem">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                  </svg>
                  Экономия до {savingsPercent.toFixed(0)}%
                </span>
              )}
            </div>
          </div>

          <div class="denom-block">
            <div class="denom-header">
              <h3 class="denom-title">
                Перевод {method.receiveCurrency}
              </h3>
            </div>
            <div class="price-table-wrapper">
              <table class="price-table">
                <thead>
                  <tr>
                    <th>Провайдер</th>
                    <th>Курс</th>
                    <th>Разница</th>
                    <th>Получаете</th>
                    <th>Цена ({method.payCurrency})</th>
                    <th style="text-align: right">Действие</th>
                  </tr>
                </thead>
                <tbody>
                  {providersWithRank.map((provider: any) => {
                    const isBest = provider.rank === 1;
                    const medal = provider.rank === 1 ? '🥇' : provider.rank === 2 ? '🥈' : provider.rank === 3 ? '🥉' : '';
                    return (
                      <tr class={isBest ? 'row-best' : ''}>
                        <td>
                          <div class="provider-cell">
                            {provider.logo && (
                              <img src={provider.logo} alt={provider.name} class="provider-logo" loading="lazy" />
                            )}
                            <span class="provider-name">
                              {providersWithRank.length > 1 && medal && <span class="medal-emoji">{medal}</span>}
                              {provider.name}
                            </span>
                            {isBest && <span class="best-badge">лучший</span>}
                          </div>
                        </td>
                        <td class="rate-cell" data-label="Курс">{provider.calculatedRate != null ? provider.calculatedRate.toFixed(4) : '—'}</td>
                        <td class={`diff-cell ${isBest ? 'diff-best' : 'diff-worse'}`} data-label="Разница">
                          <div class="diff-bar-wrapper">
                            {isBest ? '—' : `+${provider.diffPercent.toFixed(1)}%`}
                            {!isBest && (
                              <div class="diff-bar">
                                <div class="diff-bar-fill diff-bar-fill--worse" style={`width: ${Math.max((provider.diffPercent / maxDiff) * 100, 8)}%`}></div>
                              </div>
                            )}
                          </div>
                        </td>
                        <td class="take-cell" data-label="Получаете">{provider.take > 0 ? `${provider.take} ${method.receiveCurrency}` : '—'}</td>
                        <td class="price-cell" data-label={`Цена (${method.payCurrency})`}>{provider.price.toFixed(2)}</td>
                        <td class="action-cell">
                          <a
                            href={provider.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="btn-go"
                          >
                            Перейти
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                            </svg>
                          </a>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      );
    })}

    <!-- SEO: Описательный контент -->
    <article class="seo-content">
      <h2>Курсы переводов в ${country.name} — сравнение цен провайдеров</h2>
      <p>На этой странице вы можете сравнить курсы переводов в <strong>${country.name}</strong> от различных провайдеров. Мы агрегируем данные в реальном времени, чтобы вы всегда видели актуальные цены и могли выбрать наиболее выгодный вариант.</p>

      <h2>Что такое курс перевода?</h2>
      <p>Курс перевода — это соотношение, по которому вы можете отправить деньги в ${country.name}. Разные провайдеры предлагают разные курсы, и разница может быть существенной.</p>

      <h2>Как выбрать лучший курс?</h2>
      <ol>
        <li>Сравните курсы всех доступных провайдеров в таблице выше</li>
        <li>Обратите внимание на рейтинг и отзывы провайдера</li>
        <li>Учтите скорость перевода и удобство оплаты</li>
        <li>Выберите провайдера с лучшим соотношением цены и качества</li>
      </ol>
    </article>

    <!-- JSON-LD: Service -->
    <script type="application/ld+json" define:vars={{ c: country, m: country.methods }}>
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": `Курсы переводов в ${c.name}`,
      "description": `Сравнение курсов переводов в ${c.name}: ${m.map(mt => mt.name).join(', ')}`,
      "provider": {
        "@type": "Organization",
        "name": "PayCompass",
        "url": "${siteUrl}"
      },
      "areaServed": {
        "@type": "Country",
        "name": "${c.name}"
      },
      "serviceType": "Сравнение курсов переводов",
      "category": "Переводы"
    }
    </script>
  </div>
</Layout>
