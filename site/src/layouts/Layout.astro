---
import { parseAllData } from '../utils/data';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Сравниваем курсы пополнений, ваучеров и международных переводов" } = Astro.props;
const { categories } = parseAllData();
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL || '';
const siteUrl = import.meta.env.SITE || 'https://paycompass.ru';
const canonicalUrl = `${siteUrl}${base}${currentPath.replace(base, '') || ''}`;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F59E0B" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="PayCompass" />
    <meta property="og:locale" content="ru_RU" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" define:vars={{ url: canonicalUrl }}>
    {JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": title,
      "description": description,
      "url": url,
      "inLanguage": "ru",
      "isPartOf": {
        "@type": "WebSite",
        "name": "PayCompass",
        "url": `${siteUrl}${base}`,
        "description": "Сравнение курсов пополнений, ваучеров и международных переводов"
      }
    })}
    </script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <style is:global>
      /* ===== TOKENS ===== */
      :root {
        /* Typefaces */
        --font-display: 'Space Grotesk', system-ui, sans-serif;
        --font-body: 'Inter', system-ui, -apple-system, sans-serif;
        --font-mono: 'IBM Plex Mono', monospace;

        /* Palette — Night Console */
        --color-amber: #F59E0B;
        --color-amber-dim: #D97706;
        --color-amber-glow: rgba(245, 158, 11, 0.15);
        --color-teal: #14B8A6;
        --color-teal-dim: #0D9488;
        --color-teal-glow: rgba(20, 184, 166, 0.12);

        --color-night: #0B1120;
        --color-night-elevated: #131B2E;
        --color-night-subtle: #1A2540;
        --color-surface: #131B2E;
        --color-surface-hover: #1A2540;

        --color-text: #E2E8F0;
        --color-text-muted: #94A3B8;
        --color-text-faint: #64748B;

        --color-border: #1E293B;
        --color-border-light: #334155;

        --color-success: #14B8A6;
        --color-success-bg: rgba(20, 184, 166, 0.08);
        --color-warning: #F59E0B;
        --color-danger: #EF4444;

        /* Radius */
        --radius-sm: 6px;
        --radius-md: 10px;
        --radius-lg: 14px;
        --radius-xl: 20px;

        /* Shadows */
        --shadow-sm: 0 1px 3px rgba(0,0,0,0.35);
        --shadow-md: 0 4px 16px rgba(0,0,0,0.25);
        --shadow-glow-amber: 0 0 50px rgba(245, 158, 11, 0.08);
        --shadow-glow-teal: 0 0 50px rgba(20, 184, 166, 0.06);

        /* Transitions */
        --transition-fast: 120ms cubic-bezier(0.2, 0, 0.2, 1);
        --transition-base: 200ms cubic-bezier(0.2, 0, 0.2, 1);
        --transition-slow: 350ms cubic-bezier(0.2, 0, 0.2, 1);
      }

      /* ===== AMBIENT COMPASS GLOW ===== */
      body::before {
        content: '';
        position: fixed;
        top: -40%;
        left: -20%;
        width: 140%;
        height: 140%;
        background:
          radial-gradient(ellipse at 25% 15%, rgba(245, 158, 11, 0.04) 0%, transparent 45%),
          radial-gradient(ellipse at 75% 75%, rgba(20, 184, 166, 0.03) 0%, transparent 45%);
        pointer-events: none;
        z-index: 0;
        animation: compass-drift 20s ease-in-out infinite alternate;
      }

      @keyframes compass-drift {
        0% { transform: translate(0, 0) rotate(0deg); }
        50% { transform: translate(2%, -1%) rotate(1deg); }
        100% { transform: translate(-1%, 2%) rotate(-0.5deg); }
      }

      /* ===== RESET ===== */
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; scroll-behavior: smooth; }

      body {
        font-family: var(--font-body);
        background: var(--color-night);
        color: var(--color-text);
        line-height: 1.6;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      /* ===== CONTAINER ===== */
      .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 1.25rem;
      }

      /* ===== HEADER ===== */
      header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(11, 17, 32, 0.88);
        backdrop-filter: blur(16px) saturate(1.2);
        -webkit-backdrop-filter: blur(16px) saturate(1.2);
        border-bottom: 1px solid var(--color-border);
        padding: 0.75rem 0;
      }

      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .brand a {
        color: var(--color-text);
        text-decoration: none;
        font-family: var(--font-display);
        font-size: 1.375rem;
        font-weight: 700;
        letter-spacing: -0.03em;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      /* Compass needle icon */
      .brand-icon {
        display: inline-flex;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: conic-gradient(
          from 200deg,
          var(--color-amber) 0deg,
          var(--color-teal) 120deg,
          var(--color-amber) 240deg,
          var(--color-amber) 360deg
        );
        position: relative;
        flex-shrink: 0;
      }

      .brand-icon::after {
        content: '';
        position: absolute;
        inset: 5px;
        border-radius: 50%;
        background: var(--color-night);
      }

      .brand-icon::before {
        content: '';
        position: absolute;
        inset: 7px;
        border-radius: 50%;
        background: var(--color-amber);
        z-index: 1;
      }

      /* ===== NAV ===== */
      nav {
        display: flex;
        align-items: center;
        gap: 0.125rem;
        flex-wrap: wrap;
      }

      nav a {
        color: var(--color-text-muted);
        text-decoration: none;
        font-size: 0.8125rem;
        font-weight: 500;
        padding: 0.3125rem 0.625rem;
        border-radius: var(--radius-sm);
        transition: all var(--transition-fast);
        border: 1px solid transparent;
      }

      nav a:hover {
        color: var(--color-text);
        background: var(--color-night-subtle);
      }

      nav a.active {
        color: var(--color-amber);
        background: var(--color-amber-glow);
        border-color: rgba(245, 158, 11, 0.2);
      }

      /* ===== MAIN ===== */
      main {
        flex: 1;
        padding: 2.5rem 0 3.5rem;
        position: relative;
        z-index: 1;
      }

      /* ===== TYPOGRAPHY ===== */
      h1 {
        font-family: var(--font-display);
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 700;
        letter-spacing: -0.04em;
        line-height: 1.1;
        margin-bottom: 0.5rem;
      }

      h2 {
        font-family: var(--font-display);
        font-size: 1.25rem;
        font-weight: 600;
        letter-spacing: -0.02em;
        margin-bottom: 0.5rem;
      }

      h3 {
        font-family: var(--font-display);
        font-size: 1.0625rem;
        font-weight: 600;
        letter-spacing: -0.01em;
      }

      /* ===== CARDS ===== */
      .card {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        padding: 1.125rem;
        transition: all var(--transition-base);
      }

      .card:hover {
        border-color: var(--color-border-light);
        box-shadow: var(--shadow-glow-amber);
        transform: translateY(-2px);
      }

      /* ===== BADGE ===== */
      .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        font-family: var(--font-mono);
        font-size: 0.625rem;
        font-weight: 500;
        letter-spacing: 0.03em;
        padding: 0.125rem 0.5rem;
        border-radius: 100px;
        background: var(--color-night-subtle);
        color: var(--color-text-muted);
        border: 1px solid var(--color-border);
      }

      .badge--amber {
        background: var(--color-amber-glow);
        color: var(--color-amber);
        border-color: rgba(245, 158, 11, 0.25);
      }

      .badge--teal {
        background: var(--color-teal-glow);
        color: var(--color-teal);
        border-color: rgba(20, 184, 166, 0.25);
      }

      .badge--success {
        background: var(--color-success-bg);
        color: var(--color-success);
        border-color: rgba(20, 184, 166, 0.2);
      }

      /* ===== PRICE TABLE ===== */
      .price-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 0.8125rem;
      }

      .price-table th {
        padding: 0.5rem 0.75rem;
        text-align: left;
        font-family: var(--font-mono);
        font-weight: 500;
        font-size: 0.625rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--color-text-faint);
        border-bottom: 1px solid var(--color-border);
        background: var(--color-night-elevated);
      }

      .price-table th:first-child { border-radius: var(--radius-sm) 0 0 0; }
      .price-table th:last-child { border-radius: 0 var(--radius-sm) 0 0; }

      .price-table td {
        padding: 0.5rem 0.75rem;
        border-bottom: 1px solid var(--color-border);
        vertical-align: middle;
      }

      .price-table tr:last-child td { border-bottom: none; }

      .price-table tbody tr:hover {
        background: var(--color-night-subtle);
      }

      .price-table .row-best {
        background: var(--color-success-bg);
      }

      .price-table .row-best:hover {
        background: rgba(20, 184, 166, 0.15);
      }

      .provider-logo {
        height: 18px;
        width: auto;
        vertical-align: middle;
        border-radius: 4px;
      }

      /* ===== MONO TEXT ===== */
      .mono {
        font-family: var(--font-mono);
        font-size: 0.875em;
      }

      /* ===== DIVIDER ===== */
      .divider {
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--color-border) 20%, var(--color-border) 80%, transparent);
        margin: 2rem 0;
      }

      /* ===== FOOTER ===== */
      footer {
        text-align: center;
        padding: 1.5rem 0;
        color: var(--color-text-faint);
        font-size: 0.75rem;
        border-top: 1px solid var(--color-border);
        position: relative;
        z-index: 1;
      }

      footer a {
        color: var(--color-text-muted);
        text-decoration: none;
      }

      footer a:hover {
        color: var(--color-amber);
      }

      /* ===== LINK STYLES ===== */
      a { color: var(--color-amber); }
      a:hover { color: var(--color-teal); }

      /* ===== LINK BACK ===== */
      .link-back {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        color: var(--color-text-muted);
        font-size: 0.8125rem;
        font-weight: 500;
        text-decoration: none;
        padding: 0.3125rem 0.625rem;
        border-radius: var(--radius-sm);
        transition: all var(--transition-fast);
        margin-bottom: 1rem;
      }

      .link-back:hover {
        color: var(--color-text);
        background: var(--color-night-subtle);
      }

      /* ===== SUBTITLE ===== */
      .subtitle {
        color: var(--color-text-muted);
        font-size: 1rem;
        line-height: 1.6;
        max-width: 560px;
      }

      /* ===== SEARCH BAR ===== */
      .search-bar {
        position: relative;
        margin-bottom: 2rem;
      }

      .search-bar input {
        width: 100%;
        padding: 0.75rem 1rem 0.75rem 2.75rem;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        color: var(--color-text);
        font-family: var(--font-body);
        font-size: 0.9375rem;
        outline: none;
        transition: all var(--transition-fast);
      }

      .search-bar input::placeholder {
        color: var(--color-text-faint);
      }

      .search-bar input:focus {
        border-color: var(--color-amber);
        box-shadow: 0 0 0 3px var(--color-amber-glow);
      }

      .search-bar-icon {
        position: absolute;
        left: 0.875rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--color-text-faint);
        pointer-events: none;
      }

      /* ===== RESPONSIVE ===== */
      @media (max-width: 640px) {
        .header-inner {
          flex-direction: column;
          align-items: flex-start;
          gap: 0.5rem;
        }
        nav {
          gap: 0.0625rem;
        }
        nav a {
          font-size: 0.75rem;
          padding: 0.25rem 0.5rem;
        }
        main {
          padding: 1.5rem 0 2.5rem;
        }
        .card {
          padding: 0.875rem;
        }
      }

      /* ===== REDUCED MOTION ===== */
      @media (prefers-reduced-motion: reduce) {
        body::before { animation: none; }
        *, *::before, *::after {
          transition-duration: 0.01ms !important;
          animation-duration: 0.01ms !important;
        }
      }

      /* ===== FOCUS VISIBLE ===== */
      :focus-visible {
        outline: 2px solid var(--color-amber);
        outline-offset: 2px;
      }
    </style>

    <!-- Yandex.Metrika counter -->
    <script is:inline>
      (function(m,e,t,r,i,k,a){
        m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
        m[i].l=1*new Date();
        for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
        k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)
      })(window, document,'script','https://mc.yandex.ru/metrika/tag.js?id=111386743', 'ym');

      ym(111386743, 'init', {ssr:true, webvisor:true, clickmap:true, ecommerce:"dataLayer", referrer: document.referrer, url: location.href, accurateTrackBounce:true, trackLinks:true});
    </script>
    <noscript>
      <div><img src="https://mc.yandex.ru/watch/111386743" style="position:absolute; left:-9999px;" alt="" /></div>
    </noscript>
    <!-- /Yandex.Metrika counter -->

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-SP28W5J9MD"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-SP28W5J9MD');
    </script>
    <!-- /Google tag -->
  </head>
  <body>
    <header>
      <div class="container">
        <div class="header-inner">
          <div class="brand">
            <a href={base}>
              <span class="brand-icon" aria-hidden="true"></span>
              PayCompass
            </a>
          </div>
          <nav>
            <a href="/" class={currentPath === '/' ? 'active' : ''}>Все</a>
            {categories.map((cat) => (
              <a
                href={`/${cat.id}/`}
                class={currentPath.startsWith(`/${cat.id}/`) ? 'active' : ''}
              >
                {cat.name}
              </a>
            ))}
            <a
              href="/transfers/"
              class={currentPath.startsWith('/transfers/') ? 'active' : ''}
            >
              Переводы
            </a>
          </nav>
        </div>
      </div>
    </header>
    <main>
      <div class="container">
        <slot />
      </div>
    </main>
    <footer>
      <div class="container">
        <p>
          Данные актуальны на момент сборки · Обновлено: {new Date().toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' })}
        </p>
      </div>
    </footer>
  </body>
</html>
